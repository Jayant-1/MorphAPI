# MorphAPI Environment Variables
# Copy to .env and configure for local deployment

# NVIDIA NIM Provider Configuration
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_TIMEOUT_SECONDS=30.0
NVIDIA_NIM_MAX_RETRIES=1

# Playwright & Browser Automation
PLAYWRIGHT_TIMEOUT_MS=8000
PLAYWRIGHT_HEADLESS=true
ALLOW_LOCAL_TARGETS=false

# Healing and Resource Bounds
MAX_HEALING_SECONDS=15.0
MAX_DOM_CHARS=60000
MAX_SCREENSHOT_BYTES=2097152

# Debug & Telemetry
DEBUG=false
