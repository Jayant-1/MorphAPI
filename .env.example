# ==============================================================================
# MorphAPI Environment Variables
# ==============================================================================

# Core Server & Database (Person 1)
MORPHAPI_ENV=development
MORPHAPI_DB_PATH=./morphapi.db
DEFAULT_TENANT_ID=default_tenant

# NVIDIA NIM Provider Configuration (Person 2)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_TIMEOUT_SECONDS=30.0
NVIDIA_NIM_MAX_RETRIES=1

# Playwright Browser Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=20000

# Security & URL Policy
# Set to 'true' only in local automated test environments
URL_POLICY_ALLOW_LOCAL=false

# Workflow & Agent Limits
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_MAX_TOOL_CALLS=10
WORKFLOW_DEADLINE_SECONDS=120.0
PER_TOOL_TIMEOUT_SECONDS=15.0

# Persistence & Evidence Storage
WORKFLOW_CHECKPOINT_DB_PATH=morphapi_checkpoints.db
EVIDENCE_STORE_DIR=.morphapi_evidence
